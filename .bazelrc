# Continue using `WORKSPACE` with Bazel 7.
# TODO(vbshah): Remove this default once `MODULE.bazel` is fully set up.
common --noenable_bzlmod

# `repo_env` is required for the LLVM bazel build.
build \
  --copt=-Wno-parentheses \
  --copt=-Wno-sign-compare \
  --copt=-Wno-misleading-indentation \
  --copt=-Wno-narrowing \
  --strict_proto_deps=off \
  --cxxopt=-std=c++17 \
  --host_cxxopt=-std=c++17 \
  --repo_env=CC=clang \
  --define=use_fast_cpp_protos=true \
  --linkopt="-fuse-ld=lld"

build:asan --strip=never
build:asan --copt=-fsanitize=address
build:asan --copt=-O0
build:asan --copt=-fno-omit-frame-pointer
build:asan --copt=-DADDRESS_SANITIZER
build:asan --linkopt=-fsanitize=address

build:tsan --strip=never
build:tsan --copt=-fsanitize=thread
build:tsan --copt=-fno-omit-frame-pointer
build:tsan --copt=-DTHREAD_SANITIZER
build:tsan --linkopt=-fsanitize=thread

# Limit per-test thread counts to avoid threadpool oversubscription on
# high-core-count machines when running many tests in parallel, and isolate
# /dev/shm per sandbox to avoid PID-namespace shared memory collisions.
test \
  --sandbox_tmpfs_path=/dev/shm \
  --test_env=TF_NUM_INTRAOP_THREADS=8 \
  --test_env=TF_NUM_INTEROP_THREADS=8 \
  --test_env=OMP_NUM_THREADS=8 \
  --test_env=OPENBLAS_NUM_THREADS=8

